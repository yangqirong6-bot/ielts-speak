# IELTS Speaking Tool Configuration
# Copy this file to .env and fill in your values

# Your API key (OpenAI, DeepSeek, or any compatible provider)
IELTS_API_KEY=sk-your-key-here

# API base URL (change for different providers)
# OpenAI:     https://api.openai.com/v1
# DeepSeek:   https://api.deepseek.com/v1
# Ollama:     http://localhost:11434/v1
IELTS_API_BASE=https://api.openai.com/v1

# Model name
# OpenAI:  gpt-4o-mini, gpt-4o
# DeepSeek: deepseek-chat
# Ollama:  llama3, mistral, etc.
IELTS_MODEL=gpt-4o-mini

# Generation parameters
IELTS_TEMPERATURE=0.7
IELTS_MAX_TOKENS=2048
